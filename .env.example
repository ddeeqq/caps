# 환경 변수 목록. 서버는 .env를 스스로 읽지 않으니 셸·호스팅 설정에 넣거나
# `node --env-file=.env apps/server/dist/index.js` 처럼 실행한다.

# 서버 (apps/server) — 값을 비우면 괄호 안 기본값을 쓴다
PORT=3001                  # (3001)
HOST=0.0.0.0               # (0.0.0.0) 같은 와이파이의 폰이 들어오려면 0.0.0.0
DATA_DIR=./data            # (apps/server/data) JSON 저장소 위치: 팩, 세션 리포트, 방 저장본(재시작 복구)
# DATABASE_URL=postgres://user:pass@localhost:5432/malmun   # 있으면 JSON 대신 PostgreSQL 사용 (테이블 자동 생성)
# WEB_DIST=../web/dist     # (apps/web/dist) 서버가 함께 제공할 웹 빌드 위치
LOG_LEVEL=info             # debug | info | warn | error
MAX_ROOMS=500              # (500) 서버 한 대가 동시에 여는 방 수. 넘으면 "지금은 방을 더 만들 수 없어요" 안내
NODE_ENV=development       # production이면 다른 출처(CORS) 요청을 막는다

# 웹 개발 서버 (apps/web, vite)
# API_URL=http://localhost:3001   # vite가 /api, /socket.io 를 넘길 서버 주소
# HTTPS=1                         # 자체 서명 인증서로 https 개발 서버 (폰 센서·카메라 테스트용, `pnpm dev:https`)

# 도구 (tools)
# CHROME_PATH=/path/to/chrome     # `pnpm screens`가 쓸 크롬 실행 파일
